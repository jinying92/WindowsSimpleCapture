<Window x:Class="WindowsSimpleCapture.WindowSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择窗口" Height="400" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="请选择要截取的窗口:" 
                   FontSize="14" FontWeight="Bold" 
                   Margin="15,15,15,10"/>
        
        <!-- 窗口列表 -->
        <ListBox Grid.Row="1" x:Name="WindowListBox" 
                 Margin="15,0,15,10"
                 SelectionMode="Single"
                 MouseDoubleClick="WindowListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding SizeInfo}" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="15,0,15,15">
            <Button x:Name="OkButton" Content="确定" 
                    Width="80" Height="30" 
                    Click="OkButton_Click" 
                    IsDefault="True"/>
            <Button x:Name="CancelButton" Content="取消" 
                    Width="80" Height="30" 
                    Click="CancelButton_Click" 
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>