<Window x:Class="WindowsSimpleCapture.BatchDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量删除截图" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 危险按钮样式 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C82333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 筛选按钮样式 -->
        <Style x:Key="FilterButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#007ACC" Padding="20,15">
            <TextBlock Text="🗑️ 批量删除截图" 
                      FontSize="16" FontWeight="Bold" 
                      Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        
        <!-- 筛选条件 -->
        <Border Grid.Row="1" Background="White" Padding="20,15" 
                BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="删除条件:" FontSize="12" Foreground="#6C757D" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DeleteAllRadio" Content="🗂️ 全部" 
                               Style="{StaticResource FilterButtonStyle}" 
                               IsChecked="True" Checked="FilterChanged"/>
                    <RadioButton x:Name="DeleteByDateRadio" Content="📅 按日期" 
                               Style="{StaticResource FilterButtonStyle}" 
                               Checked="FilterChanged"/>
                    <RadioButton x:Name="DeleteByComputerRadio" Content="💻 按计算机" 
                               Style="{StaticResource FilterButtonStyle}" 
                               Checked="FilterChanged"/>
                    <RadioButton x:Name="DeleteByWindowRadio" Content="🪟 按窗口" 
                               Style="{StaticResource FilterButtonStyle}" 
                               Checked="FilterChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- 筛选选项 -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="20,15" 
                BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <StackPanel x:Name="FilterOptionsPanel" Visibility="Collapsed">
                <TextBlock x:Name="FilterLabel" Text="选择筛选项:" FontSize="12" Foreground="#6C757D" Margin="0,0,0,10"/>
                <ComboBox x:Name="FilterComboBox" Width="200" HorizontalAlignment="Left" 
                         SelectionChanged="FilterComboBox_SelectionChanged"/>
            </StackPanel>
        </Border>
        
        <!-- 预览列表 -->
        <Border Grid.Row="3" Background="White" Padding="20">
            <StackPanel>
                <TextBlock x:Name="PreviewLabel" Text="将要删除的截图:" FontSize="12" Foreground="#6C757D" Margin="0,0,0,10"/>
                <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="PreviewListBox" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="📷" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding WindowName}" FontSize="10" Foreground="#6C757D"/>
                                        <TextBlock Text="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                                  FontSize="10" Foreground="#6C757D"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                <TextBlock x:Name="CountLabel" Text="共 0 张截图" FontSize="11" Foreground="#007ACC" 
                          HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 操作按钮 -->
        <Border Grid.Row="4" Background="#F8F9FA" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="取消" 
                       Style="{StaticResource ModernButtonStyle}" 
                       Width="80" Margin="0,0,10,0" 
                       Click="Cancel_Click"/>
                <Button x:Name="DeleteBtn" Content="确认删除" 
                       Style="{StaticResource DangerButtonStyle}" 
                       Width="100" IsEnabled="False" 
                       Click="Delete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>